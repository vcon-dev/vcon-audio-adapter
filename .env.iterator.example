# Iterator mode configuration - traverses date/hour directories
# Copy this file to .env.iterator and update values as needed.
SOURCE_TYPE=filesystem
TRAVERSE_MODE=iterator
BASE_DIRECTORY=/path/to/audio/archive
BATCH_SIZE=1000
DIRECTORY_STATE_FILE=.directory_progress.json
SORT_ORDER=oldest_first

# Conserver settings
CONSERVER_URL=http://conserver.example:8000/vcon
CONSERVER_API_TOKEN=your-api-token-here
CONSERVER_HEADER_NAME=x-conserver-api-token

# Filename pattern: {trunk}_{originating}_{destination}_{date}_{time}.{ext}
FILENAME_PATTERN=(\d+)_(\d+)_(\d+)_\d{4}-\d{2}-\d{2}_\d{2}:\d{2}:\d{2}\.(wav|mp3|ogg|m4a|flac|aac|wma|aiff|opus)
SUPPORTED_FORMATS=wav,mp3,ogg,m4a,flac,aac,wma,aiff,opus

# Audio settings
DIALOG_TYPE=recording
EXTRACT_DURATION=true
INGRESS_LISTS=transcribe

# Processing settings
PROCESS_EXISTING=true
DELETE_AFTER_SEND=false
STATE_FILE=.audio_adapter_state.json

# Performance settings
PARALLEL_POSTS=8
RATE_LIMIT=0

# Backpressure (pause when queue > threshold, 0 = disabled)
BACKPRESSURE_THRESHOLD=5000
BACKPRESSURE_POLL_INTERVAL=5

# Lawful basis (draft-howe-vcon-lawful-basis). Unset -> no lawful-basis
# attachment is added, and a warning is logged. See README.md.
# LAWFUL_BASIS=consent
# LAWFUL_BASIS_PURPOSE=recording
# LAWFUL_BASIS_JURISDICTION=US-MA
# LAWFUL_BASIS_EXPIRATION=2027-01-02T12:00:00Z
# LAWFUL_BASIS_PROOF_MECHANISM=external_system
# LAWFUL_BASIS_PROOF_DESCRIPTION=Verbal consent captured at start of recording
