# Audio Adapter Configuration
# Copy this file to .env and update values as needed

# =============================================================================
# SOURCE CONFIGURATION
# =============================================================================

# Source type: "filesystem" or "s3"
SOURCE_TYPE=filesystem

# Directory to watch for new audio files (required when SOURCE_TYPE=filesystem)
WATCH_DIRECTORY=/path/to/audio/files

# =============================================================================
# CONSERVER CONFIGURATION (Required)
# =============================================================================

# URL of the conserver endpoint to POST vCons to
CONSERVER_URL=https://your-conserver.example.com/vcon

# API token for authentication (optional)
CONSERVER_API_TOKEN=your-api-token-here

# Header name for the API token (default: x-conserver-api-token)
CONSERVER_HEADER_NAME=x-conserver-api-token

# =============================================================================
# FILENAME PATTERN
# =============================================================================

# Regex pattern to extract sender and receiver from filenames
# Default pattern matches: sender_receiver.extension
# Example: 15085551212_19995551234.wav
# Groups: (sender)(receiver)(extension)
FILENAME_PATTERN=(\d+)_(\d+)\.(wav|mp3|ogg|m4a|flac|aac|wma|aiff|opus)

# =============================================================================
# SUPPORTED FORMATS
# =============================================================================

# Comma-separated list of supported audio file extensions
SUPPORTED_FORMATS=wav,mp3,ogg,m4a,flac,aac,wma,aiff,opus

# =============================================================================
# VCON CONFIGURATION
# =============================================================================

# Dialog type for audio recordings: "recording" or "audio"
DIALOG_TYPE=recording

# Whether to extract audio duration (requires mutagen or ffprobe)
EXTRACT_DURATION=true

# Comma-separated list of ingress queues to route vCons to
# Example: transcribe,analyze,store
INGRESS_LISTS=

# =============================================================================
# BEHAVIOR CONFIGURATION
# =============================================================================

# Whether to process existing files when adapter starts
PROCESS_EXISTING=true

# Whether to delete files after successful upload
DELETE_AFTER_SEND=false

# Path to state file for tracking processed files
STATE_FILE=.audio_adapter_state.json

# Polling interval in seconds for file system monitoring
POLL_INTERVAL=1.0

# =============================================================================
# S3 CONFIGURATION (Required when SOURCE_TYPE=s3)
# =============================================================================

# S3 bucket name
# S3_BUCKET_NAME=my-audio-bucket

# S3 prefix/folder to monitor
# S3_PREFIX=recordings/

# AWS region (optional, uses default if not specified)
# S3_REGION=us-east-1

# Polling interval for S3 in seconds
# S3_POLL_INTERVAL=30.0

# Whether to delete S3 objects after successful processing
# S3_DELETE_AFTER_SEND=false

# S3 date filtering (optional)
# Single date filter (only process files from this date)
# S3_DATE_FILTER=2024/01/15

# Date range filter (process files within date range)
# S3_DATE_RANGE_START=2024/01/01
# S3_DATE_RANGE_END=2024/01/31

# =============================================================================
# AWS CREDENTIALS (Optional - uses boto3 default chain if not specified)
# =============================================================================

# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_SESSION_TOKEN=your-session-token

# =============================================================================
# BACKPRESSURE CONFIGURATION
# =============================================================================
# BACKPRESSURE_URL=http://localhost:8080/stats/queue
# BACKPRESSURE_QUEUE=ingress:transcribe
# BACKPRESSURE_THRESHOLD=1000
# BACKPRESSURE_POLL_INTERVAL=5
